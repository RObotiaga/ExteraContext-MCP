{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExteraContext Agent Benchmark Result — protocol 1.1",
  "type": "object",
  "required": [
    "benchmark",
    "protocol_revision",
    "task_id",
    "mode",
    "repeat",
    "completed",
    "summary",
    "external_symbols",
    "uncertainties",
    "files_changed",
    "tests"
  ],
  "properties": {
    "benchmark": {
      "const": "exteracontext-agent-v1"
    },
    "task_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "repeat": {
      "type": "integer",
      "minimum": 1
    },
    "completed": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "external_symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "status"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "status": {
            "enum": [
              "target-supported",
              "donor-only",
              "unknown",
              "version-uncertain",
              "runtime-verified"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not-run"
            ]
          },
          "details": {
            "type": "string"
          },
          "evidence": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "artifact_path": {
                "type": "string",
                "minLength": 1
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "log_excerpt": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "pass"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence": {
                  "type": "object",
                  "anyOf": [
                    {
                      "required": [
                        "command"
                      ]
                    },
                    {
                      "required": [
                        "artifact_path"
                      ]
                    }
                  ]
                }
              }
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "tool_calls": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "wall_time_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "repair_iterations": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "protocol_revision": {
      "const": "1.1"
    }
  },
  "additionalProperties": true
}
