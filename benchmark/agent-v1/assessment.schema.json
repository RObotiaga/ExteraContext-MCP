{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExteraContext Agent Benchmark Assessment — protocol 1.1",
  "type": "object",
  "required": [
    "assessment_schema_version",
    "protocol_revision",
    "task_id",
    "mode",
    "repeat",
    "materially_completed",
    "invented_api",
    "donor_contamination",
    "version_mismatch",
    "constraints",
    "constraints_handled",
    "correct_unknown",
    "python_compile_success",
    "target_static_success",
    "load_success",
    "runtime_success",
    "evidence_boundary_correct",
    "clean_success"
  ],
  "properties": {
    "assessment_schema_version": {
      "const": 2
    },
    "protocol_revision": {
      "const": "1.1"
    },
    "task_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "repeat": {
      "type": "integer",
      "minimum": 1
    },
    "materially_completed": {
      "type": "boolean"
    },
    "invented_api": {
      "type": "boolean"
    },
    "donor_contamination": {
      "type": "boolean"
    },
    "version_mismatch": {
      "type": "boolean"
    },
    "constraints": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "passed",
          "evidence"
        ],
        "properties": {
          "passed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "constraints_handled": {
      "type": "boolean"
    },
    "correct_unknown": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "unnecessary_low_level_fallback": {
      "type": "boolean"
    },
    "python_compile_success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "target_static_success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "load_success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "runtime_success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "evidence_boundary_correct": {
      "type": "boolean"
    },
    "verified_test_passes": {
      "type": "integer",
      "minimum": 0
    },
    "unverified_self_reported_test_passes": {
      "type": "integer",
      "minimum": 0
    },
    "clean_success": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
