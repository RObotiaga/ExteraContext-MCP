{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExteraContext Agent Benchmark Assessment — protocol 1.1",
  "type": "object",
  "required": ["protocol_version", "assessment_schema_version", "run_id", "task_id", "mode", "repeat", "pilot", "environment_evidence", "constraints", "constraints_handled", "materially_completed", "invented_api", "donor_contamination", "version_mismatch", "correct_unknown", "evidence_boundary_correct", "unnecessary_low_level_fallback", "python_compile_success", "target_static_success", "load_success", "runtime_success", "reported_tests", "clean_success"],
  "properties": {
    "protocol_version": {"const": "1.1"},
    "assessment_schema_version": {"const": 2},
    "run_id": {"type": "string", "pattern": "^v1-[0-9]{3}$"},
    "task_id": {"type": "string"},
    "mode": {"enum": ["A", "B", "C"]},
    "repeat": {"type": "integer", "minimum": 1, "maximum": 2},
    "pilot": {"const": false},
    "environment_evidence": {
      "type": "object",
      "required": ["applicability", "rationale", "actual_mcp_package_version", "protocol_revision", "frozen_commit", "db_sha256", "attestation_sha256", "doctor_artifact_path"],
      "properties": {
        "applicability": {"enum": ["verified", "not-applicable"]},
        "rationale": {"type": "string", "minLength": 1},
        "actual_mcp_package_version": {"type": ["string", "null"]},
        "protocol_revision": {"type": ["string", "null"]},
        "frozen_commit": {"type": ["string", "null"]},
        "db_sha256": {"type": ["string", "null"]},
        "attestation_sha256": {"type": ["string", "null"]},
        "doctor_artifact_path": {"type": ["string", "null"]},
        "checkout_verified": {"type": "boolean"},
        "knowledge_commit": {"type": ["string", "null"]},
        "knowledge_tree": {"type": ["string", "null"]},
        "checkout_artifact_path": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "constraints": {"type": "array", "items": {"type": "object", "required": ["constraint", "passed", "evidence"], "properties": {"constraint": {"type": "string"}, "passed": {"type": "boolean"}, "evidence": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "constraints_handled": {"type": "boolean"},
    "materially_completed": {"type": "boolean"},
    "invented_api": {"type": "boolean"},
    "donor_contamination": {"type": "boolean"},
    "version_mismatch": {"type": "boolean"},
    "correct_unknown": {"type": ["boolean", "null"]},
    "evidence_boundary_correct": {"type": "boolean"},
    "unnecessary_low_level_fallback": {"type": "boolean"},
    "python_compile_success": {"type": ["boolean", "null"]},
    "target_static_success": {"type": ["boolean", "null"]},
    "load_success": {"type": ["boolean", "null"]},
    "runtime_success": {"type": ["boolean", "null"]},
    "reported_tests": {"type": "array", "items": {"type": "object", "required": ["name", "status", "verified"], "properties": {"name": {"type": "string"}, "status": {"enum": ["pass", "fail", "not-run"]}, "verified": {"type": "boolean"}, "command": {"type": "string", "minLength": 1}, "artifact_path": {"type": "string", "minLength": 1}, "notes": {"type": "string"}}, "additionalProperties": false}},
    "clean_success": {"type": "boolean"},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "B"}}, "required": ["mode"]},
      "then": {
        "properties": {
          "environment_evidence": {
            "required": ["checkout_verified", "knowledge_commit", "knowledge_tree", "checkout_artifact_path"],
            "properties": {
              "checkout_verified": {"const": true},
              "knowledge_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "knowledge_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "checkout_artifact_path": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
