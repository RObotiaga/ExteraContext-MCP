import json
import uuid
import base64
import hashlib
from base_plugin import BasePlugin, MethodHook
from android_utils import run_on_ui_thread
from java import jclass, dynamic_proxy

__id__ = 'exteracontext_bridge_probe'
__name__ = 'ExteraContext bridge probe'
__version__ = '0.1.0'
__description__ = 'Local Java bridge contract diagnostic. No messages or settings are read.'
__author__ = 'ExteraContext'
__sdk_version__ = '>=1.4.4.3'
EMBEDDED_DEX = None
EMBEDDED_SHA256 = None

class Probe(BasePlugin):
    def on_plugin_load(self):
        self.live = True
        run_on_ui_thread(self.run_probe)

    def on_plugin_unload(self):
        self.live = False

    def run_probe(self):
        if not self.live:
            return
        try:
            self.inspect()
        except Exception as error:
            if self.live:
                self.log('EXTERACONTEXT_BRIDGE_PROBE '+json.dumps({'schema':1,'checks':{},'bootstrap_failure':type(error).__name__}))

    def inspect(self):
        if not self.live:
            return
        report = {'probe_id':str(uuid.uuid4()),'schema':1,'checks':{},'failures':[], 'sdk_runtime':None,'dex_sha256':EMBEDDED_SHA256,'boundary':'Observed bridge contracts; application feature acceptance requires its own scenario.'}
        def check(name, fn):
            try:
                report['checks'][name] = bool(fn())
            except Exception as error:
                report['checks'][name] = False
                report['failures'].append({'check':name,'error_type':type(error).__name__})
        context = jclass('org.telegram.messenger.ApplicationLoader').applicationContext
        clazz = jclass('java.lang.Class')
        loader = context.getClassLoader()
        report['target']={'package':str(context.getPackageName()),'android_api':int(jclass('android.os.Build$VERSION').SDK_INT)}
        info=context.getPackageManager().getPackageInfo(context.getPackageName(),0)
        report['target']['client_version']=str(info.versionName)
        report['target']['version_code']=int(info.getLongVersionCode())
        def helper_metadata():
            from hook_utils import find_class
            resolved=find_class('android.graphics.Rect')
            report['find_class_methods']={name:callable(getattr(resolved,name,None)) for name in ['getDeclaredField','getDeclaredMethod','getClass']}
            return str(resolved.getDeclaredField('left').getName())=='left'
        check('find_class_metadata',helper_metadata)
        check('reflection_class',lambda: str(clazz.forName('android.graphics.Rect',False,loader).getName())=='android.graphics.Rect')
        rect = jclass('android.graphics.Rect')()
        def primitive_int():
            field=clazz.forName('android.graphics.Rect',False,loader).getDeclaredField('left')
            field.setInt(rect,17)
            return field.getInt(rect)==17
        check('primitive_int',primitive_int)
        message = jclass('android.os.Message').obtain()
        def primitive_long():
            field=clazz.forName('android.os.Message',False,loader).getDeclaredField('when')
            field.setAccessible(True)
            field.setLong(message,1234567890123)
            return field.getLong(message)==1234567890123
        check('primitive_long',primitive_long)
        dex=base64.b64decode(EMBEDDED_DEX,validate=True)
        if hashlib.sha256(dex).hexdigest()!=EMBEDDED_SHA256:
            check('independent_dex_reload',lambda:False)
            self.log('EXTERACONTEXT_BRIDGE_PROBE '+json.dumps(report,separators=(',',':')))
            return
        loaders=[]
        classes=[]
        for _ in range(2):
            fresh=jclass('dalvik.system.InMemoryDexClassLoader')(jclass('java.nio.ByteBuffer').wrap(dex),loader)
            loaders.append(fresh)
            classes.append(fresh.loadClass('app.exteracontext.probe.BridgeProbe'))
        def reload():
            first=classes[0].getDeclaredMethod('marker')
            second=classes[1].getDeclaredMethod('marker')
            return not classes[0].equals(classes[1]) and int(first.invoke(None))==1 and int(first.invoke(None))==2 and int(second.invoke(None))==1
        check('independent_dex_reload',reload)
        def proxy():
            calls=[]
            class LocalRunnable(dynamic_proxy(jclass('java.lang.Runnable'))):
                def __init__(self):
                    super().__init__()
                def run(self):
                    calls.append(True)
            method=classes[0].getDeclaredMethod('dispatch',clazz.forName('java.lang.Runnable',False,loader))
            value=method.invoke(None,LocalRunnable())
            return calls==[True] and str(value)=='java-dispatched'
        check('dynamic_proxy',proxy)
        def boolean_collision():
            name='org.telegram.messenger.SendMessagesHelper$SendMessageParams'
            obj=jclass(name)()
            field=clazz.forName(name,False,loader).getDeclaredField('notify')
            field.setAccessible(True)
            field.setBoolean(obj,True)
            return field.getBoolean(obj) is True or bool(field.getBoolean(obj))
        check('primitive_boolean_notify',boolean_collision)
        owner=self
        callbacks=[]
        class LocalHook(MethodHook):
            def before_hooked_method(self,param):
                callbacks.append('before')
                report['parameter_methods']={'setObjectExtra':callable(getattr(param,'setObjectExtra',None)),'getObjectExtra':callable(getattr(param,'getObjectExtra',None))}
            def after_hooked_method(self,param):
                callbacks.append('after')
        def hook():
            method=clazz.forName('android.view.View',False,loader).getDeclaredMethod('setTag',clazz.forName('java.lang.Object',False,loader))
            handle=owner.hook_method(method,LocalHook())
            try:
                jclass('android.view.View')(context).setTag('exteracontext-local-probe')
                return callbacks==['before','after']
            finally:
                owner.unhook_method(handle)
        check('hook_invocation',hook)
        if self.live:
            self.log('EXTERACONTEXT_BRIDGE_PROBE '+json.dumps(report,separators=(',',':')))
